---
import GithubIcon from "../assets/icons/github.svg";
import LinkedinIcon from "../assets/icons/linkedin.svg";
import EmailIcon from "../assets/icons/email.svg";
---

<section
        id="welcome"
        class="hero"
        aria-labelledby="welcome-heading"
        itemscope
        itemtype="https://schema.org/Person"
>
        <div class="hero-inner">
                <header class="content">
                        <p class="status" aria-label="Current state">
                                <span class="status-dot" aria-hidden="true"></span>
                                <span class="status-text">CURRENTLY</span>
                                <span class="status-sep" aria-hidden="true">·</span>
                                <span class="status-loc">Cosmic Society</span>
                                <span class="status-sep" aria-hidden="true">·</span>
                                <span class="status-loc">Manila</span>
                        </p>

                        <h1 id="welcome-heading" itemprop="name" class="name">
                                <span class="name-line">Ervin</span>
                                <span class="name-line name-line--shift">Pangilinan</span>
                        </h1>

                        <div class="hero-grid">
                                <div class="hero-main">
                                        <p class="tagline" itemprop="description">
                                                I've been writing software since 2021. Today I build software that helps people connect
                                                and engage at <span class="tagline-mark">Cosmic Society</span> and chase whatever rabbit
                                                hole catches, my weapon currently <span class="tagline-mark">TypeScript</span>, <span class="tagline-mark">Next.js</span>, <span class="tagline-mark">Supabase</span>, <span class="tagline-mark">NestJS</span>,
                                                and digging into <span class="tagline-mark">AI automation</span> and <span class="tagline-mark">depth system design</span>.
                                        </p>

                                        <nav class="text-links" aria-label="Contact links">
                                                <a
                                                        href="mailto:pangilinanervin22@gmail.com"
                                                        class="text-link"
                                                        aria-label="Email"
                                                        itemprop="email"
                                                >
                                                        <EmailIcon class="text-link-icon" aria-hidden="true" />
                                                        <span>Email</span>
                                                </a>
                                                <a
                                                        href="https://github.com/pangilinanervin22"
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="text-link"
                                                        aria-label="GitHub"
                                                        itemprop="sameAs"
                                                >
                                                        <GithubIcon class="text-link-icon" aria-hidden="true" />
                                                        <span>GitHub</span>
                                                </a>
                                                <a
                                                        href="https://www.linkedin.com/in/ervin-pangilinan-9b9410231"
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="text-link"
                                                        aria-label="LinkedIn"
                                                        itemprop="sameAs"
                                                >
                                                        <LinkedinIcon class="text-link-icon" aria-hidden="true" />
                                                        <span>LinkedIn</span>
                                                </a>
                                        </nav>
                                </div>

                                <aside class="hero-side" aria-label="Currently exploring">
                                        <p class="exploring-label">
                                                <span aria-hidden="true">//</span> Currently exploring
                                        </p>
                                        <ul class="exploring-list">
                                                <li>
                                                        <span class="exploring-idx" aria-hidden="true">01</span>
                                                        AI automation pipelines
                                                </li>
                                                <li>
                                                        <span class="exploring-idx" aria-hidden="true">02</span>
                                                        Distributed system design
                                                </li>
                                                <li>
                                                        <span class="exploring-idx" aria-hidden="true">03</span>
                                                        Event-driven architecture
                                                </li>
                                        </ul>
                                </aside>
                        </div>
                </header>
        </div>

        <a class="scroll-hint" href="#introduction" aria-label="Scroll to About section">
                <svg width="14" height="9" viewBox="0 0 16 10" fill="none" aria-hidden="true">
                        <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="scroll-hint-label">01 / About</span>
        </a>
</section>

<style>
        .hero {
                position: relative;
                display: flex;
                align-items: center;
                width: 100%;
                min-height: calc(100vh - 72px);
                padding: 4rem var(--gutter) 5.5rem;
        }

        .hero-inner {
                max-width: var(--container);
                width: 100%;
                margin-inline: auto;
        }

        .content {
                width: 100%;
        }

        /* Status line */
        .status {
                font-family: var(--font-mono);
                font-size: 0.78rem;
                font-weight: 500;
                letter-spacing: 0.06em;
                color: var(--color-text-muted);
                margin: 0 0 2.25rem;
                line-height: 1;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                opacity: 0;
                animation: fadeSlideUp 0.6s ease 0.1s forwards;
        }

        .status-dot {
                width: 7px;
                height: 7px;
                background: var(--color-text-primary);
                animation: statusPulse 2.4s ease-in-out infinite;
        }

        @keyframes statusPulse {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.25; }
        }

        .status-text {
                color: var(--color-text-primary);
                font-weight: 600;
        }

        .status-sep {
                opacity: 0.4;
        }

        .status-loc {
                color: var(--color-text-secondary);
        }

        /* Name — two-line editorial staircase */
        .name {
                font-family: var(--font-display);
                font-size: clamp(3.25rem, 11vw, 8.25rem);
                font-weight: 700;
                letter-spacing: -0.045em;
                line-height: 0.92;
                color: var(--color-text-primary);
                margin: 0 0 clamp(2rem, 4.5vw, 3.25rem);
                display: flex;
                flex-direction: column;
        }

        .name-line {
                display: block;
                opacity: 0;
                animation: fadeSlideUp 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) 0.2s forwards;
        }

        .name-line--shift {
                animation-delay: 0.3s;
        }

        @media (min-width: 768px) {
                .name-line--shift {
                        margin-left: clamp(2rem, 9vw, 8rem);
                }
        }

        /* Two-column row under the name */
        .hero-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr);
                gap: 2.5rem;
        }

        @media (min-width: 1024px) {
                .hero-grid {
                        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
                        gap: 4rem;
                        align-items: start;
                }
        }

        .hero-main {
                display: flex;
                flex-direction: column;
                gap: 2rem;
        }

        /* Tagline */
        .tagline {
                font-size: clamp(1.05rem, 1.6vw, 1.25rem);
                font-weight: 400;
                line-height: 1.55;
                color: var(--color-text-secondary);
                max-width: 56ch;
                margin: 0;
                opacity: 0;
                animation: fadeSlideUp 0.7s ease 0.45s forwards;
        }

        .tagline-mark {
                color: var(--color-text-primary);
                font-weight: 500;
        }

        /* Contact links */
        .text-links {
                display: flex;
                flex-wrap: wrap;
                gap: 1.4rem;
                align-items: center;
                opacity: 0;
                animation: fadeSlideUp 0.7s ease 0.58s forwards;
        }

        .text-link {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                font-family: var(--font-mono);
                font-size: 0.82rem;
                font-weight: 500;
                letter-spacing: 0.02em;
                color: var(--color-text-secondary);
                text-decoration: none;
                padding: 0.45rem 0.7rem;
                border: 1px solid var(--color-border);
                border-radius: var(--radius-sm);
                transition:
                        color 0.2s ease,
                        background-color 0.2s ease,
                        border-color 0.2s ease;
        }

        .text-link:hover {
                color: var(--color-background);
                background: var(--color-text-primary);
                border-color: var(--color-text-primary);
        }

        :global(.text-link-icon) {
                width: 14px;
                height: 14px;
        }

        /* Currently exploring — side panel with hairline rail */
        .hero-side {
                opacity: 0;
                animation: fadeSlideUp 0.7s ease 0.72s forwards;
        }

        @media (min-width: 1024px) {
                .hero-side {
                        border-left: 1px solid var(--color-border);
                        padding-left: 2rem;
                }
        }

        .exploring-label {
                font-family: var(--font-mono);
                font-size: 0.72rem;
                font-weight: 500;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: var(--color-text-muted);
                margin: 0 0 1rem;
                line-height: 1;
        }

        .exploring-list {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 0.85rem;
                font-family: var(--font-mono);
                font-size: 0.82rem;
                color: var(--color-text-secondary);
        }

        .exploring-list li {
                display: flex;
                align-items: baseline;
                gap: 0.75rem;
                line-height: 1.4;
        }

        .exploring-idx {
                font-size: 0.68rem;
                color: var(--color-text-faint);
        }

        /* Scroll hint */
        .scroll-hint {
                position: absolute;
                bottom: 1.75rem;
                left: 50%;
                transform: translateX(-50%);
                display: inline-flex;
                flex-direction: column;
                align-items: center;
                gap: 0.45rem;
                color: var(--color-text-muted);
                text-decoration: none;
                opacity: 0;
                animation: fadeSlideUp 0.7s ease 0.95s forwards;
        }

        .scroll-hint svg {
                animation: gentle-bounce 2.4s ease-in-out 1.6s infinite;
        }

        .scroll-hint-label {
                font-family: var(--font-mono);
                font-size: 0.7rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                color: var(--color-text-muted);
        }

        .scroll-hint:hover {
                color: var(--color-text-primary);
        }

        @keyframes gentle-bounce {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(4px); }
        }

        @keyframes fadeSlideUp {
                from { opacity: 0; transform: translateY(16px); }
                to { opacity: 1; transform: translateY(0); }
        }

        /* Mobile */
        @media (max-width: 768px) {
                .hero {
                        padding: 2.5rem var(--gutter) 4.5rem;
                        min-height: 92vh;
                }
        }

        @media (max-width: 480px) {
                .name {
                        font-size: clamp(2.7rem, 14vw, 4rem);
                }
                .tagline {
                        font-size: 1rem;
                }
                .exploring-list {
                        font-size: 0.76rem;
                }
        }

        @media (prefers-reduced-motion: reduce) {
                .status,
                .name-line,
                .tagline,
                .text-links,
                .hero-side,
                .scroll-hint {
                        animation: none;
                        opacity: 1;
                }
                .status-dot,
                .scroll-hint svg {
                        animation: none;
                }
                .text-link {
                        transition: none;
                }
        }
</style>
