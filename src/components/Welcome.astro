---
import GithubIcon from "../assets/icons/github.svg";
import LinkedinIcon from "../assets/icons/linkedin.svg";
import EmailIcon from "../assets/icons/email.svg";
import DownloadIcon from "../assets/icons/download.svg";
import TitleBlock from "./TitleBlock.astro";
import Dimension from "./_common/Dimension.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const resumeHref = `${base}/Ervin_Pangilinan_Resume.pdf`;

// Measured results, repeated from the experience and project copy in src/data.
// Never add a number here that the copy does not state: a smoke test checks
// that each one appears further down the page.
const results = [
	{ figure: "~30,000", what: "peak users at large-scale events", where: "Cosmic Society" },
	{ figure: "~45%", what: "cut in cloud costs", where: "HEQS Group" },
	{ figure: "30%+", what: "faster page loads", where: "HEQS Group" },
	{ figure: "~2,000+", what: "more organic page visits", where: "HEQS Group" },
];
---

<section
	id="welcome"
	class="hero"
	aria-labelledby="welcome-heading"
	data-sheet="01"
	data-sheet-title="Cover"
>
	<div class="hero-inner">
		<header class="content">
			<!-- The cover sheet's one moment of motion: the name is drawn in outline
			     and then filled, and the dimension line under it is drawn after. -->
			<p class="hero-status">Full-stack developer in Manila, remote for teams in Berlin and Sydney</p>
			<h1 id="welcome-heading" class="name">
				<span class="name-line">Ervin</span>
				<span class="name-line name-line--shift">Pangilinan</span>
			</h1>
			<div class="name-dim-wrap">
				<Dimension target="#welcome-heading" />
			</div>

			<div class="hero-grid hero-rest">
				<div class="hero-main">
					<p class="tagline">
						I've been building software since 2021, back when it was still a hobby.
						Today the hobby is the job: at <span class="tagline-mark"
							>Cosmic Society</span
						> I make software that helps people connect and engage, mostly using <span
							class="tagline-mark">TypeScript</span
						>, <span class="tagline-mark">Next.js</span>, <span class="tagline-mark"
							>Supabase</span
						>, and <span class="tagline-mark">NestJS</span>, and I still mess around
						with <span class="tagline-mark">AI automation</span> and <span
							class="tagline-mark">systems design</span
						>.
					</p>

					<nav class="text-links" aria-label="Resume and contact links">
						<a href={resumeHref} class="text-link text-link--primary" download>
							<DownloadIcon class="text-link-icon" aria-hidden="true" />
							<span>Resume</span>
						</a>
						<a
							href="mailto:pangilinanervin22@gmail.com"
							class="text-link"
							aria-label="Email"
						>
							<EmailIcon class="text-link-icon" aria-hidden="true" />
							<span>Email</span>
						</a>
						<a
							href="https://github.com/pangilinanervin22"
							target="_blank"
							rel="noopener noreferrer"
							class="text-link"
							aria-label="GitHub"
						>
							<GithubIcon class="text-link-icon" aria-hidden="true" />
							<span>GitHub</span>
						</a>
						<a
							href="https://www.linkedin.com/in/pangilinanervin22"
							target="_blank"
							rel="noopener noreferrer"
							class="text-link"
							aria-label="LinkedIn"
						>
							<LinkedinIcon class="text-link-icon" aria-hidden="true" />
							<span>LinkedIn</span>
						</a>
					</nav>
				</div>

				<aside class="hero-side results" aria-label="Results in production">
					<ul class="results-list" role="list">
						{
							results.map((r) => (
								<li class="result">
									<strong class="fig">{r.figure}</strong>
									<span class="result-what">{r.what}</span>
									<span class="result-where">{r.where}</span>
								</li>
							))
						}
					</ul>
				</aside>
			</div>
		</header>

		<TitleBlock sheets={6} />
	</div>
</section>

<script>
	// Once a name line has drawn itself, drop the animation so its fill follows
	// the theme tokens normally from then on (a theme switch mid-session would
	// otherwise fight a forwards-filled keyframe).
	document.querySelectorAll<HTMLElement>(".name-line").forEach((line) => {
		line.addEventListener("animationend", () => line.classList.add("is-drawn"), {
			once: true,
		});
	});
</script>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
		min-height: calc(100vh - 72px);
		padding: 4rem var(--gutter) 5.5rem;
	}

	.hero-inner {
		max-width: var(--container);
		width: 100%;
		margin-inline: auto;
	}

	.content {
		width: 100%;
	}

	/* Status line over the name: where the work happens, in the instrument face */
	.hero-status {
		margin: 0 0 clamp(1rem, 2vw, 1.5rem);
		font-family: var(--font-mono);
		font-size: 0.84rem;
		font-weight: 500;
		line-height: 1.5;
		color: var(--color-text-primary);
	}

	/* Name: two-line staircase, each line shrink-wrapped so the dimension
	   below can measure the ink rather than the column */
	.name {
		font-family: var(--font-display);
		font-size: clamp(3.25rem, 11vw, 8.25rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 0.92;
		color: var(--color-text-primary);
		margin: 0 0 clamp(1.6rem, 2.8vw, 2.4rem);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.name-line {
		display: block;
	}

	@media (min-width: 768px) {
		.name-line--shift {
			margin-left: clamp(2rem, 9vw, 8rem);
		}
	}

	.name-dim-wrap {
		position: relative;
		width: 100%;
		margin: 0 0 clamp(2rem, 4.5vw, 3.25rem);
	}

	/* Two-column row under the name */
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2.5rem;
	}

	@media (min-width: 1024px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
			gap: 4rem;
			align-items: start;
		}
	}

	/* From 1440px the full title block is fixed in the viewport's bottom-right
	   corner while the cover is on screen. The row stops short of its column
	   (block 20rem + 1rem offset + 1rem air, from the container's right edge
	   at 50vw + 600px), so on a short screen the results never run under it. */
	@media (min-width: 1440px) {
		.hero-grid {
			margin-right: max(0px, calc(980px - 50vw));
		}
	}

	.hero-main {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	/* Tagline */
	.tagline {
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		font-weight: 400;
		line-height: 1.55;
		color: var(--color-text-secondary);
		max-width: 56ch;
		margin: 0;
	}

	.tagline-mark {
		color: var(--color-text-primary);
		font-weight: 500;
	}

	/* Contact links */
	.text-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.4rem;
		align-items: center;
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.84rem;
		font-weight: 500;
		color: var(--color-text-secondary);
		text-decoration: none;
		padding: 0.45rem 0.7rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		transition:
			color 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	.text-link:hover {
		color: var(--color-background);
		background: var(--color-text-primary);
		border-color: var(--color-text-primary);
	}

	/* Primary action: filled by default, inverts on hover like everything else */
	.text-link--primary {
		color: var(--color-background);
		background: var(--color-text-primary);
		border-color: var(--color-text-primary);
	}

	.text-link--primary:hover {
		color: var(--color-text-primary);
		background: transparent;
	}

	:global(.text-link-icon) {
		width: 14px;
		height: 14px;
	}

	/* Results: a ruled schedule, the figure set large and what it measured
	   beside it, with where it was measured underneath */
	@media (min-width: 1024px) {
		.hero-side {
			border-left: 1px solid var(--color-border);
			padding-left: 2rem;
		}
	}

	.results-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.result {
		display: grid;
		/* wide enough for "~30,000", the widest figure, so every label lines up */
		grid-template-columns: 7.75rem minmax(0, 1fr);
		grid-template-areas:
			"fig what"
			"fig where";
		column-gap: 1rem;
		align-items: baseline;
		padding: 0.7rem 0;
		border-top: 1px solid var(--color-border);
	}

	.result:first-child {
		border-top: 0;
		padding-top: 0;
	}

	.result .fig {
		grid-area: fig;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
		color: var(--color-text-primary);
	}

	.result-what {
		grid-area: what;
		font-size: 0.95rem;
		line-height: 1.35;
		color: var(--color-text-secondary);
	}

	.result-where {
		grid-area: where;
		margin-top: 0.2rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-text-muted);
	}

	/* Phones: four equal buttons in two rows instead of a ragged wrap */
	@media (max-width: 520px) {
		.text-links {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		.text-link {
			justify-content: center;
			padding-block: 0.65rem;
		}
	}

	/* The drawing moment. Reduced motion gets the finished sheet at once. */
	@media (prefers-reduced-motion: no-preference) {
		.name-line:not(.is-drawn) {
			color: transparent;
			-webkit-text-stroke: 1px var(--color-text-primary);
			clip-path: inset(-0.25em 100% -0.25em -0.05em);
			animation: draw-name 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) 0.15s forwards;
		}

		.name-line--shift:not(.is-drawn) {
			animation-delay: 0.45s;
		}

		.name-dim-wrap {
			transform: scaleX(0);
			transform-origin: left center;
			animation: draw-dim 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) 1.3s forwards;
		}

		.hero-rest {
			opacity: 0;
			animation: appear 0.55s ease 1.15s forwards;
		}
	}

	@keyframes draw-name {
		0% {
			clip-path: inset(-0.25em 100% -0.25em -0.05em);
			color: transparent;
			-webkit-text-stroke-width: 1px;
		}
		60% {
			clip-path: inset(-0.25em -0.05em -0.25em -0.05em);
			color: transparent;
			-webkit-text-stroke-width: 1px;
		}
		100% {
			clip-path: inset(-0.25em -0.05em -0.25em -0.05em);
			color: var(--color-text-primary);
			-webkit-text-stroke-width: 0;
		}
	}

	@keyframes draw-dim {
		to {
			transform: scaleX(1);
		}
	}

	@keyframes appear {
		to {
			opacity: 1;
		}
	}

	/* Mobile */
	@media (max-width: 768px) {
		.hero {
			padding: 2.5rem var(--gutter) 3.5rem;
			min-height: 92vh;
		}
	}

	@media (max-width: 480px) {
		.name {
			font-size: clamp(2.7rem, 14vw, 4rem);
		}
		.tagline {
			font-size: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.text-link {
			transition: none;
		}
	}
</style>
