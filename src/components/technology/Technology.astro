---
import { skillGroups } from "../../data/technologies";
---

<section id="tech" class="tech-section" aria-labelledby="tech-title" itemscope itemtype="https://schema.org/ItemList">
	<h2 id="tech-title" class="tech-title">My Skills</h2>

	<div class="tech-grid" role="list">
		{
			skillGroups.map((group, gi) => (
				<div class="tech-card" role="listitem" data-index={gi}>
					<div class="card-header">
						<span class="card-index" aria-hidden="true">
							{String(gi + 1).padStart(2, "0")}
						</span>
						<span class="category-label">{group.category}</span>
					</div>
					<div class="skill-pills">
						{group.skills.map((skill, si) => (
							<span
								class="skill-pill"
								itemprop="itemListElement"
								itemscope
								itemtype="https://schema.org/Thing"
							>
								<meta itemprop="position" content={String(gi * 10 + si + 1)} />
								<span itemprop="name">{skill}</span>
							</span>
						))}
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.tech-section {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		padding: clamp(2rem, 5vw, 3rem) 1rem clamp(2.5rem, 6vw, 3.5rem);
	}

	.tech-title {
		font-size: clamp(2.4rem, 4.5vw, 3.4rem);
		margin: 0;
		letter-spacing: 1px;
		font-weight: 600;
		text-align: center;
	}

	.tech-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		width: min(880px, 90%);
	}

	.tech-card {
		padding: 1.4rem 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		box-shadow: 0 1px 3px var(--color-shadow-soft);
		transition:
			transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
			box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@media (hover: hover) {
		.tech-card:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 12px var(--color-shadow);
		}
	}

	.card-header {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--color-border);
	}

	.card-index {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 400;
		color: var(--color-text-faint);
		letter-spacing: 0.02em;
	}

	.category-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: var(--color-text-primary);
	}

	.skill-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.skill-pill {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 400;
		padding: 0.3rem 0.6rem;
		background: var(--color-surface-alt);
		border-radius: 4px;
		color: var(--color-text-muted);
		letter-spacing: 0.02em;
		transition: color 0.2s ease, background-color 0.2s ease;
		cursor: default;
	}

	@media (hover: hover) {
		.skill-pill:hover {
			color: var(--color-text-primary);
			background: var(--color-surface-muted);
		}
	}

	@media (max-width: 640px) {
		.tech-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tech-card {
			transition: none;
		}
		.tech-card:hover {
			transform: none;
		}
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	if (typeof window !== "undefined") {
		const prefersReduced = window.matchMedia(
			"(prefers-reduced-motion: reduce)"
		).matches;

		if (!prefersReduced) {
			gsap.registerPlugin(ScrollTrigger);

			const init = () => {
				const section = document.querySelector("#tech");
				if (!section) return;

				const title = section.querySelector(".tech-title");
				if (title) {
					gsap.fromTo(
						title,
						{ filter: "blur(6px)", opacity: 0, y: 16 },
						{
							filter: "blur(0px)",
							opacity: 1,
							y: 0,
							duration: 0.6,
							ease: "power2.out",
							scrollTrigger: {
								trigger: title,
								start: "top 90%",
								end: "top 60%",
								scrub: true,
							},
						}
					);
				}

				const cards = section.querySelectorAll(".tech-card");
				cards.forEach((card) => {
					gsap.fromTo(
						card,
						{ filter: "blur(8px)", opacity: 0, y: 20 },
						{
							filter: "blur(0px)",
							opacity: 1,
							y: 0,
							duration: 0.6,
							ease: "power2.out",
							scrollTrigger: {
								trigger: card,
								start: "top 92%",
								end: "top 65%",
								scrub: true,
							},
						}
					);
				});
			};

			requestAnimationFrame(() => {
				init();
				window.addEventListener("load", () => ScrollTrigger.refresh());
			});
		}
	}
</script>
