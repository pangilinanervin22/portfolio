---
import SectionHead from "../_common/SectionHead.astro";
import { skillTiers, allSkills } from "../../data/technologies";

const tierClass = (label: string) => `tier tier--${label.toLowerCase()}`;
---

<section
	id="tech"
	class="tech-section"
	aria-labelledby="tech-title"
	itemscope
	itemtype="https://schema.org/ItemList"
>
	<div class="rail">
		<SectionHead
			number="03"
			title="Stack"
			headingId="tech-title"
			meta={`${allSkills.length} tools`}
			intro="Tools I work with, sorted by how often I actually reach for them."
		/>

		<div class="tiers">
			{
				skillTiers.map((tier, ti) => (
					<div
						class={tierClass(tier.label)}
						data-reveal
						style={`--reveal-delay: ${ti * 0.06}s`}
					>
						<div class="tier-side">
							<p class="tier-name">
								<span class="tier-mark" aria-hidden="true">//</span>
								{tier.label}
							</p>
							<p class="tier-context">{tier.context}</p>
						</div>
						<ul class="tier-skills" role="list">
							{tier.skills.map((skill, si) => (
								<li
									class="skill"
									itemprop="itemListElement"
									itemscope
									itemtype="https://schema.org/Thing"
										data-cursor
										data-cursor-label={`${String(si + 1).padStart(2, "0")} / ${String(tier.skills.length).padStart(2, "0")}`}
								>
									<meta itemprop="position" content={String(ti * 10 + si + 1)} />
									<span itemprop="name">{skill}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.tech-section {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: clamp(4rem, 10vh, 7rem) var(--gutter) 2rem;
	}

	.rail {
		max-width: var(--container);
		width: 100%;
	}

	.tiers {
		display: flex;
		flex-direction: column;
	}

	/* Colophon rows: tier label column | flowing type specimen */
	.tier {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.85rem 3rem;
		padding-block: 1.75rem;
		border-top: 1px solid var(--color-border);
	}

	.tier:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	@media (min-width: 850px) {
		.tier {
			grid-template-columns: 200px minmax(0, 1fr);
			padding-block: 2.1rem;
		}
	}

	.tier-side {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	@media (min-width: 850px) {
		.tier-side {
			flex-direction: column;
			gap: 0.45rem;
		}
	}

	.tier-name {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: var(--color-text-primary);
		margin: 0;
		line-height: 1.2;
	}

	.tier-mark {
		color: var(--color-text-muted);
		font-weight: 500;
	}

	.tier-context {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: var(--color-text-muted);
		text-transform: lowercase;
		margin: 0;
		line-height: 1.2;
	}

	.tier-skills {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 0.55em;
		row-gap: 0.35em;
	}

	.skill {
		line-height: 1.45;
		cursor: default;
		transition: color 0.2s ease;
	}

	.skill:not(:last-child)::after {
		content: "·";
		margin-left: 0.55em;
		color: var(--color-text-faint);
		font-weight: 400;
	}

	/* Type scale encodes frequency of use */
	.tier--core .skill {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.2vw, 1.7rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--color-text-primary);
	}

	.tier--often .skill {
		font-size: clamp(1rem, 1.4vw, 1.15rem);
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.tier--sometimes .skill {
		font-size: 0.95rem;
		font-weight: 400;
		color: var(--color-text-muted);
	}

	.tier--tools .skill {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}

	@media (hover: hover) {
		.tier--often .skill:hover,
		.tier--sometimes .skill:hover,
		.tier--tools .skill:hover {
			color: var(--color-text-primary);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.skill {
			transition: none;
		}
	}
</style>
