---
import { Image } from "astro:assets";
import introImage from "../../assets/me.jpg";
import SectionHead from "../_common/SectionHead.astro";
import Dimension from "../_common/Dimension.astro";

const builds = [
	{
		title: "Web platforms",
		detail: "Production apps in TypeScript, Next.js, NestJS. Server-rendered, SPA, or hybrid.",
	},
	{
		title: "Mobile apps",
		detail: "Cross-platform with React Native + Expo. Offline-first, secure releases.",
	},
	{
		title: "DevOps & deploys",
		detail: "CI/CD pipelines, Docker containers, cloud hosting on Vercel, AWS, Azure, DigitalOcean, Heroku.",
	},
	{
		title: "Game dev",
		detail: "Small 2D Unity prototypes when I want to think about something different.",
	},
];
---

<section
	id="introduction"
	class="introduction-main-container"
	aria-labelledby="about-heading"
	data-sheet="02"
	data-sheet-title="About"
>
	<div class="section-head">
		<SectionHead
			number="02"
			title="About"
			headingId="about-heading"
			meta="writing software since 2021"
		/>
	</div>

	<div class="introduction-image-container">
		<figure class="introduction-image" data-cursor>
			<Image
				src={introImage}
				alt="Ervin Pangilinan - Full Stack Developer and Computer Science Graduate specializing in web applications, mobile development, and DevOps"
				width={480}
				height={720}
				loading="eager"
				decoding="async"
				format="webp"
				quality={85}
				densities={[1, 1.5, 2]}
				sizes="(max-width: 480px) 280px, (max-width: 768px) 360px, (max-width: 1024px) 380px, 380px"
				class="intro-portrait"
			/>
			<figcaption class="portrait-caption">
				<span>Manila, 2026</span>
				<span class="caption-right">fig. 01</span>
			</figcaption>
		</figure>
		<!-- Vertical dimension beside the plate: the portrait's rendered height -->
		<div class="portrait-dim" aria-hidden="true">
			<Dimension target=".intro-portrait" axis="y" />
		</div>
	</div>

	<div class="introduction-content">
		<p class="introduction-description">
			I write software, mostly for the web. Started in 2021 as a hobby and it turned into a
			career. Today I'm at Cosmic Society building a multi-brand event and retail-activation
			platform that supports ~30,000 peak users at large-scale events. Before that I shipped
			production work for HEQS Group (Sydney) and FiveTwenty IT Services (Manila), and I'm a
			Computer Science grad from Cavite State University.
		</p>
		<p class="introduction-description-secondary">
			I work across the stack, but backend is where I go deepest: REST APIs, role-based
			access, row-level security, audit logging, query optimization, CI/CD. I care about clean
			architecture, accessibility, and code the next person can read without a guided tour.
			The rest of my time goes to whatever I'm learning right now.
		</p>

		<p class="exploring">
			<span class="exploring-label">Currently exploring</span>{" "}AI automation pipelines, distributed system design, cheaper infra at scale.
		</p>
		<section class="introduction-skills" aria-labelledby="skills-heading">
			<h3 id="skills-heading">What I build</h3>
			<!-- Ruled schedule rows: not links, so no boxes and no hover -->
			<dl class="build-list">
				{
					builds.map((b) => (
						<div class="build-row">
							<dt>{b.title}</dt>
							<dd>{b.detail}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</div>
</section>

<style>
	.introduction-main-container {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-areas:
			"head"
			"image"
			"content";
		justify-items: start;
		width: 100%;
		max-width: calc(var(--container) + 2 * var(--gutter));
		padding: clamp(4rem, 10vh, 7rem) var(--gutter) 2rem;
		gap: 24px;

		@media (min-width: 1024px) {
			grid-template-columns: minmax(280px, 380px) 1fr;
			grid-template-areas:
				"head head"
				"image content";
			column-gap: 3.5rem;
			row-gap: 0.5rem;
			align-items: start;
		}
	}

	.section-head {
		grid-area: head;
		width: 100%;
	}

	/* Portrait as a technical plate: square, hairline, grayscale until hover */
	.introduction-image-container {
		grid-area: image;
		position: relative;
		width: 100%;
		max-width: 380px;
		margin: 0;
	}

	.introduction-image {
		position: relative;
		padding: 10px 10px 8px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		margin: 0;
		transition: border-color 0.3s ease;
	}

	.intro-portrait {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center top;
		border-radius: 0;
		display: block;
		filter: grayscale(1) contrast(1.04);
		transition: filter 0.45s ease;
	}

	@media (hover: hover) {
		.introduction-image:hover {
			border-color: var(--color-text-muted);
		}
		.introduction-image:hover .intro-portrait {
			filter: grayscale(0) contrast(1);
		}
	}

	.portrait-caption {
		margin: 10px 2px 2px;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--color-text-muted);
		line-height: 1;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

	/* The dimension hangs in the margin to the right of the plate */
	.portrait-dim {
		display: none;
		position: absolute;
		top: 0;
		bottom: 0;
		right: -1.6rem;
		width: 1px;
	}

	@media (min-width: 640px) {
		.portrait-dim {
			display: block;
		}
	}

	.introduction-content {
		grid-area: content;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
		width: 100%;
	}

	.introduction-description,
	.introduction-description-secondary {
		font-size: 1.05rem;
		line-height: 1.7;
		font-weight: 400;
		color: var(--color-text-secondary);
		margin: 0;
		max-width: 68ch;
	}

	.introduction-description-secondary {
		font-size: 1rem;
	}

	.introduction-skills {
		width: 100%;
		margin-top: 1.25rem;
	}

	.introduction-skills > h3 {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.84rem;
		font-weight: 500;
		color: var(--color-text-primary);
		line-height: 1;
	}

	.exploring {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
		max-width: 42em;
	}

	.exploring-label {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--color-text-primary);
		margin-right: 0.5rem;
	}

	/* What I build: ruled schedule rows, title left and detail right */
	.build-list {
		margin: 0;
		border-bottom: 1px solid var(--color-border);
	}

	.build-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.25rem 1.5rem;
		padding: 0.9rem 0;
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 640px) {
		.build-row {
			grid-template-columns: 11rem minmax(0, 1fr);
			align-items: baseline;
		}
	}

	.build-row dt {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
	}

	.build-row dd {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text-secondary);
	}

	@media (prefers-reduced-motion: reduce) {
		.introduction-image,
		.intro-portrait {
			transition: none;
		}
	}
</style>
