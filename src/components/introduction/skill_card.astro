---
interface Props {
        title: string;
        content: string;
        icon?: any;
        index?: string; // "01" … "04"
}

const { title, content, icon: Icon, index } = Astro.props;
const id = `skill-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`;
---

<article
        class="skill-card"
        aria-labelledby={`${id}-title`}
        itemscope
        itemtype="https://schema.org/DefinedTerm"
>
        {index && <span class="skill-card-index" aria-hidden="true">{index}</span>}
        <h4 id={`${id}-title`} class="skill-card-title" itemprop="name">
                {Icon && (
                        <Icon
                                class="skill-card-icon"
                                aria-hidden="true"
                                focusable="false"
                        />
                )}
                {title}
        </h4>
        <p class="skill-card-content" itemprop="description">{content}</p>
</article>

<style scoped>
        /* Quadrant cell: square, flat, inverts to black on hover */
        .skill-card {
                position: relative;
                display: flex;
                flex-direction: column;
                gap: 0.6rem;
                width: 100%;
                height: 100%;
                padding: 1.4rem 1.5rem 1.5rem;
                background: var(--color-background);
                transition:
                        background-color 0.25s ease,
                        color 0.25s ease;
        }

        .skill-card-index {
                position: absolute;
                top: 1.15rem;
                right: 1.25rem;
                font-family: var(--font-mono);
                font-size: 0.68rem;
                letter-spacing: 0.08em;
                color: var(--color-text-faint);
                line-height: 1;
                transition: color 0.25s ease;
        }

        .skill-card-title {
                font-family: var(--font-display);
                font-size: 1.15rem;
                line-height: 1.2;
                font-weight: 700;
                letter-spacing: -0.01em;
                display: flex;
                align-items: center;
                gap: 0.6rem;
                margin: 0;
                color: var(--color-text-primary);
                transition: color 0.25s ease;
        }

        :global(.skill-card-icon) {
                width: 1.35em;
                height: 1.35em;
                flex-shrink: 0;
                color: var(--color-text-primary);
                transition: color 0.25s ease;
        }

        .skill-card-content {
                font-size: 0.95rem;
                line-height: 1.65;
                color: var(--color-text-secondary);
                margin: 0;
                transition: color 0.25s ease;
        }

        @media (hover: hover) {
                .skill-card:hover {
                        background: var(--color-text-primary);
                }
                .skill-card:hover .skill-card-title,
                .skill-card:hover :global(.skill-card-icon) {
                        color: var(--color-background);
                }
                .skill-card:hover .skill-card-content {
                        color: var(--color-background);
                        opacity: 0.85;
                }
                .skill-card:hover .skill-card-index {
                        color: var(--color-background);
                        opacity: 0.6;
                }
        }

        .skill-card:focus-within {
                outline: 2px solid var(--color-focus-ring);
                outline-offset: -2px;
        }

        @media (prefers-reduced-motion: reduce) {
                .skill-card,
                .skill-card-title,
                .skill-card-content,
                .skill-card-index {
                        transition: none;
                }
        }
</style>
