---
interface Props {
	number: string; // sheet index, "02"
	title: string; // "About"
	headingId: string; // id used by the aria-labelledby of the parent section
	meta?: string; // right-end annotation, e.g. "5 builds"
	intro?: string; // optional one-line intro under the title
}

const { number, title, headingId, meta, intro } = Astro.props as Props;
---

<header class="s-head" data-reveal>
	<p class="s-rule" aria-hidden="true">
		<span class="s-num">Sheet {number}</span>
		<span class="s-line" data-draw></span>
		{meta && <span class="s-meta">{meta}</span>}
	</p>
	<h2 id={headingId} class="s-title">{title}</h2>
	{intro && <p class="s-intro">{intro}</p>}
</header>

<style>
	.s-head {
		width: 100%;
		margin: 0 0 clamp(2rem, 4vw, 3rem);
	}

	.s-rule {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 1.4rem;
		line-height: 1;
	}

	.s-num,
	.s-meta {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		white-space: nowrap;
	}

	.s-num {
		font-weight: 500;
		color: var(--color-text-primary);
	}

	.s-line {
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}

	.s-meta {
		color: var(--color-text-muted);
	}

	/* A longer note wraps under itself on a phone instead of running off the rule */
	@media (max-width: 640px) {
		.s-line {
			min-width: 1rem;
		}

		.s-meta {
			white-space: normal;
			text-align: right;
			line-height: 1.4;
		}
	}

	.s-title {
		font-family: var(--font-display);
		font-size: clamp(2.75rem, 6vw, 4.25rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 0.95;
		margin: 0;
		color: var(--color-text-primary);
	}

	.s-intro {
		max-width: 58ch;
		margin: 1rem 0 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}
</style>
