---
// The title block of the drawing set: the ruled box every drafting sheet
// carries in its corner, with the drawing title, sheet number and revision.
// On wide screens it is fixed to the bottom-right of the viewport: full while
// the cover is under it, then only the sheet counter, which fits in the right
// margin clear of the text (the tracker in Layout sets `.is-compact` and ticks
// the counter over). Narrower screens keep it static on the cover sheet.
import { SITE_TITLE, SITE_ROLE } from "../consts";
import { updatedIso } from "../lib/updated";

interface Props {
	sheets: number; // total number of sheets in the set
}

const { sheets } = Astro.props;
const total = String(sheets).padStart(2, "0");
---

<aside class="title-block" aria-label="Sheet information">
	<dl class="tb">
		<div class="tb-cell tb-drawing">
			<dt class="visually-hidden">Drawing</dt>
			<dd class="tb-name">{SITE_TITLE}</dd>
			<dd class="tb-sub">{SITE_ROLE}</dd>
		</div>
		<div class="tb-cell tb-sheet">
			<dt class="tb-key">Sheet</dt>
			<dd class="tb-val">
				<span data-tb-index>01</span><span class="tb-of"> / {total}</span>
			</dd>
			<dd class="tb-sub" data-tb-name>Cover</dd>
		</div>
		<div class="tb-cell tb-now">
			<dt class="tb-key">Now at</dt>
			<dd class="tb-val">Cosmic Society</dd>
			<dd class="tb-sub">from Manila, Philippines</dd>
		</div>
		<div class="tb-cell tb-rev">
			<dt class="tb-key">Rev</dt>
			<dd class="tb-val"><time datetime={updatedIso}>{updatedIso}</time></dd>
		</div>
	</dl>
</aside>

<style>
	.title-block {
		width: 100%;
		max-width: 26rem;
		margin-top: 2.75rem;
	}

	/* Below 1440px the margin has no room for a fixed block, so it sits in the
	   cover's bottom-right corner, where a printed title block would be */
	@media (min-width: 1024px) {
		.title-block {
			width: 20rem;
			max-width: none;
			margin-left: auto;
		}
	}

	@media (min-width: 1440px) {
		.title-block {
			position: fixed;
			right: 1rem;
			bottom: 1rem;
			margin: 0;
			z-index: 90;
			background: var(--color-background);
		}

		/* Past the cover: the sheet counter alone, narrow enough for the margin */
		.title-block.is-compact {
			width: auto;
		}

		.is-compact .tb {
			grid-template-columns: auto;
		}

		.is-compact .tb-drawing,
		.is-compact .tb-now,
		.is-compact .tb-rev {
			display: none;
		}

		.is-compact .tb-sheet {
			min-width: 0;
			border-left: 0;
			padding: 0.45rem 0.6rem 0.5rem;
		}

		.is-compact .tb-sheet .tb-key {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.is-compact .tb-sub {
			font-size: 0.6875rem;
		}
	}

	/* The swap between full block and counter fades rather than jumps */
	@media (min-width: 1440px) and (prefers-reduced-motion: no-preference) {
		.title-block .tb {
			animation: tb-full 0.2s ease-out;
		}

		.title-block.is-compact .tb {
			animation-name: tb-compact;
		}
	}

	@keyframes tb-full {
		from {
			opacity: 0;
		}
	}

	@keyframes tb-compact {
		from {
			opacity: 0;
		}
	}

	.tb {
		margin: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		border: 1px solid var(--color-text-primary);
		line-height: 1.35;
	}

	.tb-cell {
		min-width: 0;
		padding: 0.6rem 0.8rem 0.65rem;
	}

	.tb-sheet,
	.tb-rev {
		min-width: 6.75rem;
		border-left: 1px solid var(--color-text-primary);
	}

	.tb-now,
	.tb-rev {
		border-top: 1px solid var(--color-text-primary);
	}

	.tb dd {
		margin: 0;
	}

	.tb-name {
		font-family: var(--font-display);
		font-size: 0.98rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
	}

	.tb-key {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--color-text-muted);
		margin-bottom: 0.1rem;
	}

	.tb-val {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--color-text-primary);
		white-space: nowrap;
	}

	/* inline-block so the sheet number can roll in when the sheet changes */
	[data-tb-index] {
		display: inline-block;
	}

	.tb-of {
		color: var(--color-text-muted);
		font-weight: 400;
	}

	.tb-sub {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-text-muted);
	}

	.visually-hidden {
		position: absolute !important;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		border: 0;
		white-space: nowrap;
	}
</style>
