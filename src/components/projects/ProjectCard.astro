---
import { Image } from "astro:assets";
import type { ProjectItem } from "../../data/projects";
import GithubIcon from "../../assets/icons/github.svg";
import LinkIcon from "../../assets/icons/link.svg";

interface Props {
	project: ProjectItem;
	index: number;
	featured?: boolean;
}
const { project: p, index: i, featured = false } = Astro.props as Props;
const plate = String(i + 1).padStart(2, "0");
---

<li class={`plate${featured ? " plate--featured" : ""}`}>
	<article class="plate-inner" aria-labelledby={`proj-${i}-title`}>
		{
			p.image && (
				<figure class="media" data-cursor>
					<Image
						src={p.image}
						widths={[480, 768, 1200].filter((w) => w <= p.image!.width)}
						sizes={
							featured
								? "(min-width: 1024px) 660px, (min-width: 768px) 90vw, 100vw"
								: "(min-width: 768px) 45vw, 100vw"
						}
						format="webp"
						quality={80}
						alt={
							p.imageAlt ||
							`${p.title} - screenshot showcasing the ${p.stack.join(", ")} stack`
						}
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="visually-hidden">{p.imageAlt || p.title}</figcaption>
				</figure>
			)
		}
		<div class="body">
			<p class="plate-row">
				<span class="plate-num">Plate {plate}</span>
				{p.year && <span class="plate-year">{p.year}</span>}
			</p>
			<h3 id={`proj-${i}-title`} class="plate-title">
				{p.title}
			</h3>
			<p class="plate-desc">{p.description}</p>
			<p class="stack-line">
				<span class="visually-hidden">Stack: </span>
				{p.stack.join(", ")}
			</p>
			{
				(p.demo || p.repo) && (
					<nav class="links" aria-label="Project links">
						{p.demo && (
							<a
								class="link"
								href={p.demo}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`Open live site for ${p.title}`}
							>
								<LinkIcon class="icon" aria-hidden="true" />
								<span>Live site</span>
							</a>
						)}
						{p.repo && (
							<a
								class="link"
								href={p.repo}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`Open GitHub repo for ${p.title}`}
							>
								<GithubIcon class="icon" aria-hidden="true" />
								<span>GitHub</span>
							</a>
						)}
					</nav>
				)
			}
		</div>
	</article>
</li>

<style>
	/* A plate: the screenshot framed on hatched ground, a ruled caption row,
	   and the notes beneath. No box around the whole thing. */
	.plate {
		position: relative;
		min-width: 0;
	}

	@media (min-width: 768px) {
		.plate--featured {
			grid-column: 1 / -1;
		}
	}

	.plate-inner {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	@media (min-width: 1024px) {
		.plate--featured .plate-inner {
			display: grid;
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
			gap: 2.25rem;
		}
	}

	/* Hatching fills whatever the letterboxed screenshot leaves empty, the
	   way a draughtsman hatches a cut surface rather than leaving it blank */
	.media {
		position: relative;
		aspect-ratio: 16/9;
		width: 100%;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--color-border);
		background-image: repeating-linear-gradient(
			-45deg,
			var(--color-hatch) 0 1px,
			transparent 1px 9px
		);
		transition: border-color 0.25s ease;
	}

	@media (min-width: 1024px) {
		.plate--featured .media {
			aspect-ratio: auto;
			height: 100%;
			min-height: 320px;
		}
	}

	.media img {
		width: 100%;
		height: 100%;
		/* letterbox on the hatched ground: the whole screenshot stays
		   visible and nothing gets stretched to fit the plate */
		object-fit: contain;
		display: block;
	}

	@media (hover: hover) {
		.plate-inner:hover .media {
			border-color: var(--color-text-primary);
		}
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		flex-grow: 1;
		padding-top: 1rem;
	}

	@media (min-width: 1024px) {
		.plate--featured .body {
			padding-top: 0;
		}
	}

	.plate-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin: 0;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.plate-num {
		color: var(--color-text-primary);
		font-weight: 500;
	}

	.plate-year {
		white-space: nowrap;
	}

	.plate-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.35rem;
		line-height: 1.2;
		font-weight: 700;
		letter-spacing: -0.015em;
	}

	.plate--featured .plate-title {
		font-size: clamp(1.6rem, 2.4vw, 2.1rem);
	}

	.plate-desc {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
		flex-grow: 1;
	}

	.plate--featured .plate-desc {
		font-size: 1.02rem;
	}

	.stack-line {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.links {
		display: flex;
		gap: 0.7rem;
		margin-top: 0.25rem;
	}

	.link {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		padding: 0.5rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--color-text-primary);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	:global(.icon) {
		width: 0.95rem;
		height: 0.95rem;
		display: block;
	}

	@media (hover: hover) {
		.link:hover {
			background: var(--color-text-primary);
			border-color: var(--color-text-primary);
			color: var(--color-background);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.media,
		.link {
			transition: none;
		}
	}
</style>
