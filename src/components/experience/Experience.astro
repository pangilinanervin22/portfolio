---
import SectionHead from "../_common/SectionHead.astro";
import { experiences } from "../../data/experiences";

const pad2 = (n: number) => String(n + 1).padStart(2, "0");
---

<section
	id="experience"
	class="experience-section"
	aria-labelledby="experience-title"
	itemscope
	itemtype="https://schema.org/Person"
>
	<div class="rail">
		<SectionHead
			number="02"
			title="Experience"
			headingId="experience-title"
			meta={`${experiences.length} entries · 2021 — now`}
		/>

		<ol class="ledger" role="list">
			{
				experiences.map((item, i) => {
					const isCurrent = item.period.includes("Present");
					return (
						<li
							class={`entry ${isCurrent ? "entry--current" : ""}`}
							data-reveal
							style={`--reveal-delay: ${Math.min(i * 0.06, 0.24)}s`}
						>
							<article
								class="entry-grid"
								aria-labelledby={`exp-${i}-role`}
								itemscope
								itemtype="https://schema.org/WorkExperience"
							>
								<div class="entry-side">
									<span class="entry-index" aria-hidden="true">
										{pad2(i)}
									</span>
									<div class="entry-when">
										<time itemprop="startDate">{item.period}</time>
										{isCurrent && (
											<span class="now-badge" aria-label="Current role">
												<span aria-hidden="true">//</span> NOW
											</span>
										)}
									</div>
								</div>

								<div class="entry-body">
									<header class="entry-head">
										<h3
											id={`exp-${i}-role`}
											class="role"
											itemprop="jobTitle"
										>
											{item.role}
										</h3>
										<p class="meta">
											<span
												class="company"
												itemprop="worksFor"
												itemscope
												itemtype="https://schema.org/Organization"
											>
												<span itemprop="name">{item.company}</span>
											</span>
											<span class="location">{item.location}</span>
										</p>
									</header>
									<p class="summary" itemprop="description">
										{item.summary}
									</p>
									{item.highlights.length > 0 && (
										<ul class="highlights" role="list">
											{item.highlights.map((h) => (
												<li>
													<span class="hl-glyph" aria-hidden="true">→</span>
													<span>{h}</span>
												</li>
											))}
										</ul>
									)}
									{item.tech && (
										<p class="tech-line" aria-label="Technologies used">
											{item.tech.map((cur) => (
												<span class="tech-item">{cur}</span>
											))}
										</p>
									)}
								</div>
							</article>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>

<style>
	.experience-section {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: clamp(4rem, 10vh, 7rem) var(--gutter) 2rem;
	}

	.rail {
		max-width: var(--container);
		width: 100%;
	}

	.ledger {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.entry {
		border-top: 1px solid var(--color-border);
	}

	.entry:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.entry-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 3rem;
		padding: 2rem 0.75rem;
		margin-inline: -0.75rem;
		transition: background-color 0.25s ease;
	}

	@media (min-width: 850px) {
		.entry-grid {
			grid-template-columns: 200px minmax(0, 1fr);
			padding: 2.5rem 1rem;
			margin-inline: -1rem;
		}
	}

	@media (hover: hover) {
		.entry:hover .entry-grid {
			background-color: var(--color-accent-subtle);
		}
	}

	/* Left column: index + period */
	.entry-side {
		display: flex;
		align-items: baseline;
		gap: 0.85rem;
	}

	@media (min-width: 850px) {
		.entry-side {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.8rem;
		}
	}

	.entry-index {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: 0.32rem 0.45rem;
	}

	.entry--current .entry-index {
		color: var(--color-background);
		background: var(--color-text-primary);
		border-color: var(--color-text-primary);
	}

	.entry-when {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}

	.entry-when time {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--color-text-primary);
	}

	.now-badge {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--color-text-primary);
		padding: 0.18rem 0.4rem;
		border: 1px solid var(--color-text-primary);
		border-radius: var(--radius-sm);
		line-height: 1.4;
		text-transform: uppercase;
	}

	/* Right column: content */
	.entry-body {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		min-width: 0;
	}

	.entry-head {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.role {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 1.2vw + 1.05rem, 1.7rem);
		line-height: 1.2;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		margin: 0;
	}

	.meta .company {
		color: var(--color-text-secondary);
		font-weight: 500;
	}

	.meta .company::after {
		content: "·";
		margin-left: 0.6rem;
		opacity: 0.55;
	}

	.summary {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
		letter-spacing: 0.2px;
		max-width: 72ch;
	}

	.highlights {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.highlights li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.65rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text-secondary);
		max-width: 78ch;
	}

	.hl-glyph {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		line-height: 1.55;
	}

	/* Tech as a ruled mono line instead of chips */
	.tech-line {
		margin: 0.25rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		line-height: 1.9;
		color: var(--color-text-muted);
	}

	.tech-item {
		transition: color 0.2s ease;
	}

	.tech-item:not(:last-child)::after {
		content: " · ";
		color: var(--color-text-faint);
	}

	@media (hover: hover) {
		.tech-item:hover {
			color: var(--color-text-primary);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.entry-grid,
		.tech-item {
			transition: none;
		}
	}
</style>
