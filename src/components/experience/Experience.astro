---
import { Image } from "astro:assets";
import SectionHead from "../_common/SectionHead.astro";
import { experiences } from "../../data/experiences";
---

<section
	id="experience"
	class="experience-section"
	aria-labelledby="experience-title"
	data-sheet="03"
	data-sheet-title="Experience"
>
	<div class="rail">
		<SectionHead
			number="03"
			title="Experience"
			headingId="experience-title"
			meta="Teams in Germany, Australia and the Philippines"
		/>

		<ol class="ledger" role="list">
			{
				experiences.map((item, i) => {
					const isCurrent = item.period.includes("Present");
					return (
						<li class={`entry ${isCurrent ? "entry--current" : ""}`} data-reveal>
							<article class="entry-grid" aria-labelledby={`exp-${i}-company`}>
								<div class="entry-when">
									<span class="entry-tick" aria-hidden="true" />
									<span class="entry-period">{item.period}</span>
									{isCurrent && <span class="visually-hidden">Current role</span>}
								</div>

								<div class="entry-body">
									{/* The employer leads: it is what differs from one entry to the next */}
									<header class="entry-head">
										{item.logo && (
											<span class="entry-logo" data-cursor>
												<Image
													src={item.logo}
													width={Math.min(item.logo.width, 280)}
													format="webp"
													quality={85}
													alt={item.logoAlt || `${item.company} logo`}
													loading="lazy"
													decoding="async"
												/>
											</span>
										)}
										<h3 id={`exp-${i}-company`} class="company">
											{item.company}
										</h3>
										<p class="role">{item.role}</p>
										<p class="location">{item.location}</p>
									</header>
									<p class="summary">{item.summary}</p>
									{item.highlights.length > 0 && (
										<ul class="highlights" role="list">
											{item.highlights.map((h) => (
												<li>{h}</li>
											))}
										</ul>
									)}
									{item.tech && (
										<p class="tech-line">
											<span class="visually-hidden">Technologies used: </span>
											{item.tech.join(", ")}
										</p>
									)}
								</div>
							</article>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>

<style>
	.experience-section {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: clamp(4rem, 10vh, 7rem) var(--gutter) 2rem;
	}

	.rail {
		max-width: var(--container);
		width: 100%;
	}

	.ledger {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.entry {
		border-top: 1px solid var(--color-border);
	}

	.entry:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.entry-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 2.5rem;
		padding: 2rem 0;
	}

	/* No hover tint: an entry is not a link, so it does not act like one */
	@media (min-width: 850px) {
		.entry-grid {
			grid-template-columns: 168px minmax(0, 1fr);
			padding: 2.5rem 0;
		}
	}

	/* Left rail: chronology, the dates carry the timeline order */
	.entry-when {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem 0.75rem;
	}

	@media (min-width: 850px) {
		.entry-when {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.7rem;
			padding-top: 0.15rem;
		}
	}

	/* Ruler-tick marker: filled for the current role, hollow for past ones */
	.entry-tick {
		flex: none;
		width: 9px;
		height: 9px;
		border: 1px solid var(--color-text-muted);
		border-radius: 1px;
		background: transparent;
	}

	.entry--current .entry-tick {
		background: var(--color-text-primary);
		border-color: var(--color-text-primary);
	}

	.entry-period {
		font-family: var(--font-mono);
		font-size: 0.84rem;
		font-weight: 500;
		color: var(--color-text-primary);
		white-space: nowrap;
	}

	/* Right column: company identity + detail */
	.entry-body {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		min-width: 0;
	}

	.entry-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
	}

	/* Company logo as a full-colour letterhead mark. A neutral, near-white
	   plate keeps the three mixed-background logos (black / blue / transparent)
	   reading consistently in both themes. */
	.entry-logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 122px;
		height: 52px;
		margin-bottom: 0.35rem;
		padding: 9px 12px;
		background: var(--gray-0);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
	}

	/* The frame is wider than the widest logo, so every logo is height-bound
	   inside it: all three render at the same height in an identical box. */
	.entry-logo img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	@media (min-width: 850px) {
		.entry-logo {
			width: 138px;
			height: 58px;
		}
	}

	.company {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 1.2vw + 1.05rem, 1.7rem);
		line-height: 1.2;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.role {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
		color: var(--color-text-primary);
	}

	.location {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.summary {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
		max-width: 72ch;
	}

	.highlights {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	/* Leader-line bullets: a short rule instead of a glyph */
	.highlights li {
		position: relative;
		padding-left: 1.3rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text-secondary);
		max-width: 78ch;
	}

	.highlights li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.78em;
		width: 0.65rem;
		height: 1px;
		background: var(--color-text-muted);
	}

	/* Tech as a mono line, comma separated */
	.tech-line {
		margin: 0.25rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}

</style>
