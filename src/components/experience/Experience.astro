---
import SectionHead from "../_common/SectionHead.astro";
import { experiences } from "../../data/experiences";
---

<section
	id="experience"
	class="experience-section"
	aria-labelledby="experience-title"
	itemscope
	itemtype="https://schema.org/Person"
>
	<div class="rail">
		<SectionHead
			number="02"
			title="Experience"
			headingId="experience-title"
			meta={`${experiences.length} entries · 2021 — now`}
		/>

		<ol class="ledger" role="list">
			{
				experiences.map((item, i) => {
					const isCurrent = item.period.includes("Present");
					return (
						<li
							class={`entry ${isCurrent ? "entry--current" : ""}`}
							data-reveal
							style={`--reveal-delay: ${Math.min(i * 0.06, 0.24)}s`}
						>
							<article
								class="entry-grid"
								aria-labelledby={`exp-${i}-role`}
								itemscope
								itemtype="https://schema.org/WorkExperience"
							>
								<div class="entry-when">
									<span class="entry-tick" aria-hidden="true" />
									<time class="entry-period" itemprop="startDate">
										{item.period}
									</time>
									{isCurrent && (
										<span class="now-badge" aria-label="Current role">
											<span aria-hidden="true">//</span> NOW
										</span>
									)}
								</div>

								<div class="entry-body">
									<header class="entry-head">
										{item.logo && (
											<span class="entry-logo" data-cursor>
												<img
													src={item.logo.src}
													width={item.logo.width}
													height={item.logo.height}
													alt={item.logoAlt || `${item.company} logo`}
													loading="lazy"
													decoding="async"
												/>
											</span>
										)}
										<h3
											id={`exp-${i}-role`}
											class="role"
											itemprop="jobTitle"
										>
											{item.role}
										</h3>
										<p class="meta">
											<span
												class="company"
												itemprop="worksFor"
												itemscope
												itemtype="https://schema.org/Organization"
											>
												<span itemprop="name">{item.company}</span>
											</span>
											<span class="location">{item.location}</span>
										</p>
									</header>
									<p class="summary" itemprop="description">
										{item.summary}
									</p>
									{item.highlights.length > 0 && (
										<ul class="highlights" role="list">
											{item.highlights.map((h) => (
												<li>
													<span class="hl-glyph" aria-hidden="true">→</span>
													<span>{h}</span>
												</li>
											))}
										</ul>
									)}
									{item.tech && (
										<p class="tech-line" aria-label="Technologies used">
											{item.tech.map((cur) => (
												<span class="tech-item">{cur}</span>
											))}
										</p>
									)}
								</div>
							</article>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>

<style>
	.experience-section {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: clamp(4rem, 10vh, 7rem) var(--gutter) 2rem;
	}

	.rail {
		max-width: var(--container);
		width: 100%;
	}

	.ledger {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.entry {
		border-top: 1px solid var(--color-border);
	}

	.entry:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.entry-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 2.5rem;
		padding: 2rem 0.75rem;
		margin-inline: -0.75rem;
		transition: background-color 0.25s ease;
	}

	@media (min-width: 850px) {
		.entry-grid {
			grid-template-columns: 168px minmax(0, 1fr);
			padding: 2.5rem 1rem;
			margin-inline: -1rem;
		}
	}

	@media (hover: hover) {
		.entry:hover .entry-grid {
			background-color: var(--color-accent-subtle);
		}
	}

	/* Left rail: chronology — the dates carry the timeline order */
	.entry-when {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem 0.75rem;
	}

	@media (min-width: 850px) {
		.entry-when {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.7rem;
			padding-top: 0.15rem;
		}
	}

	/* Ruler-tick marker: filled for the current role, hollow for past ones */
	.entry-tick {
		flex: none;
		width: 9px;
		height: 9px;
		border: 1px solid var(--color-text-muted);
		border-radius: 1px;
		background: transparent;
	}

	.entry--current .entry-tick {
		background: var(--color-text-primary);
		border-color: var(--color-text-primary);
	}

	.entry-period {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		color: var(--color-text-primary);
		white-space: nowrap;
	}

	.entry--current .entry-period {
		font-weight: 600;
	}

	.now-badge {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--color-text-primary);
		padding: 0.18rem 0.4rem;
		border: 1px solid var(--color-text-primary);
		border-radius: var(--radius-sm);
		line-height: 1.4;
		text-transform: uppercase;
	}

	/* Right column: company identity + detail */
	.entry-body {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		min-width: 0;
	}

	.entry-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
	}

	/* Company logo as a full-colour letterhead mark. A neutral, near-white
	   plate keeps the three mixed-background logos (black / blue / transparent)
	   reading consistently in both themes. */
	.entry-logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 122px;
		height: 52px;
		margin-bottom: 0.35rem;
		padding: 9px 12px;
		background: var(--gray-0);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
	}

	/* The frame is wider than the widest logo's aspect ratio, so every logo
	   is height-bound inside it: all three render at the same height and sit
	   in an identical box, regardless of their differing proportions. */
	.entry-logo img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	@media (min-width: 850px) {
		.entry-logo {
			width: 138px;
			height: 58px;
		}
	}

	.role {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 1.2vw + 1.05rem, 1.7rem);
		line-height: 1.2;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		margin: 0;
	}

	.meta .company {
		color: var(--color-text-secondary);
		font-weight: 500;
	}

	.meta .company::after {
		content: "·";
		margin-left: 0.6rem;
		opacity: 0.55;
	}

	.summary {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
		letter-spacing: 0.2px;
		max-width: 72ch;
	}

	.highlights {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.highlights li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.65rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-text-secondary);
		max-width: 78ch;
	}

	.hl-glyph {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		line-height: 1.55;
	}

	/* Tech as a ruled mono line instead of chips */
	.tech-line {
		margin: 0.25rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		line-height: 1.9;
		color: var(--color-text-muted);
	}

	.tech-item {
		transition: color 0.2s ease;
	}

	.tech-item:not(:last-child)::after {
		content: " · ";
		color: var(--color-text-faint);
	}

	@media (hover: hover) {
		.tech-item:hover {
			color: var(--color-text-primary);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.entry-grid,
		.tech-item {
			transition: none;
		}
	}
</style>
