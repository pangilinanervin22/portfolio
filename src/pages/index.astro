---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/NavBar.astro";
import Introduction from "../components/introduction/Introduction.astro";
import Experience from "../components/experience/Experience.astro";
import Techs from "../components/technology/Technology.astro";
import Projects from "../components/projects/Projects.astro";
---

<Layout>
	<div class="page">
		<Navbar />
		<Welcome />
		<Introduction />
		<Experience />
		<Techs />
		<Projects />
	</div>
</Layout>

<style>
	.page {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}
</style>
